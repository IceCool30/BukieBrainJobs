# BukieBrainJobs Environment Variables
# Complete environment variable contract per TECHNICAL_SPEC.md Section 6

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:pass@host:5432/bukiebrainjobs?pgbouncer=true"
DIRECT_URL="postgresql://user:pass@host:5432/bukiebrainjobs"

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL="rediss://default:token@host:6379"

# ── Auth ──────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="your-nextauth-secret-key"
NEXTAUTH_URL="https://bukiebrainjobs.com"
JWT_SECRET="your-jwt-secret-key"

# ── Termii (SMS / OTP) ────────────────────────────────────────────────
TERMII_API_KEY="your-termii-api-key"
TERMII_SENDER_ID="BukieBrain"

# ── Paystack ──────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY="your-paystack-secret-key"
PAYSTACK_PUBLIC_KEY="your-paystack-public-key"
PAYSTACK_WEBHOOK_SECRET="your-webhook-secret"
PLATFORM_SUBACCOUNT_CODE="your-paystack-subaccount-code"

# ── Smile Identity ────────────────────────────────────────────────────
SMILE_PARTNER_ID="your-partner-id"
SMILE_API_KEY="your-api-key"
SMILE_CALLBACK_URL="https://bukiebrainjobs.com/api/verification/webhook"

# ── Cloudinary ────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="bukiebrainjobs"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ── Resend (Email) ────────────────────────────────────────────────────
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="noreply@bukiebrainjobs.com"

# ── Socket.io Server ──────────────────────────────────────────────────
SOCKET_SERVER_URL="https://socket.bukiebrainjobs.com"
SOCKET_SERVER_PORT="3001"

# ── Expo / Mobile ─────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL="https://bukiebrainjobs.com/api"
EXPO_PUBLIC_SOCKET_URL="https://socket.bukiebrainjobs.com"
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY="your-paystack-public-key"
EXPO_PUBLIC_GOOGLE_MAPS_KEY="your-google-maps-api-key"

# ── PostHog ───────────────────────────────────────────────────────────
POSTHOG_KEY="your-posthog-api-key"
NEXT_PUBLIC_POSTHOG_KEY="your-posthog-api-key"

# ── Sentry ────────────────────────────────────────────────────────────
SENTRY_DSN="your-sentry-dsn-url"
NEXT_PUBLIC_SENTRY_DSN="your-sentry-dsn-url"

# ── Encryption ────────────────────────────────────────────────────────
ENCRYPTION_KEY="32-byte-hex-key-for-aes-256-gcm"

# ── Application ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_USE_MOCK_DATA="false"

# ── Development ───────────────────────────────────────────────────────
# Set to 'development' for dev environment, 'production' for prod
NODE_ENV="development"
