{
  "name": "bukiebrainjobs-monorepo",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@bukiebrainjobs/web",
    "build": "npm run build --workspace=@bukiebrainjobs/web",
    "lint": "npm run lint --workspace=@bukiebrainjobs/web",
    "type-check": "turbo run type-check",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.10.9",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "postcss": "^8.5.3"
  }
}