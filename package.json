{
  "name": "bukiebrainjobs-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:push": "turbo run db:push",
    "web:dev": "pnpm --filter @bukiebrainjobs/web dev",
    "mobile:start": "pnpm --filter @bukiebrainjobs/mobile start",
    "mobile:tunnel": "pnpm --filter @bukiebrainjobs/mobile tunnel",
    "mobile:web": "pnpm --filter @bukiebrainjobs/mobile web",
    "mobile:android": "pnpm --filter @bukiebrainjobs/mobile android",
    "mobile:ios": "pnpm --filter @bukiebrainjobs/mobile ios",
    "clean": "turbo run clean && rm -rf node_modules && rm -rf apps/*/node_modules && rm -rf packages/*/node_modules && rm -rf services/*/node_modules"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "turbo": "^2.10.9",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "^4.1.4",
      "@xmldom/xmldom": "^0.9.12",
      "xmldom": "^0.6.0",
      "tar": "^7.5.21",
      "postcss": "^8.5.23",
      "decode-uri-component": "^0.5.0",
      "deepmerge-ts": "^8.0.0",
      "image-size": "^2.0.2",
      "uuid": "^11.1.1",
      "sharp": "^0.34.4",
      "browserslist": "^4.28.7"
    }
  }
}
