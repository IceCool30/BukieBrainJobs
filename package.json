{
  "name": "bukiebrainjobs-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:push": "turbo run db:push",
    "web:dev": "pnpm --filter @bukiebrainjobs/web dev",
    "mobile:start": "pnpm --filter @bukiebrainjobs/mobile start",
    "mobile:tunnel": "pnpm --filter @bukiebrainjobs/mobile tunnel",
    "mobile:web": "pnpm --filter @bukiebrainjobs/mobile web",
    "mobile:android": "pnpm --filter @bukiebrainjobs/mobile android",
    "mobile:ios": "pnpm --filter @bukiebrainjobs/mobile ios",
    "loop:status": "bash scripts/nine-status.sh",
    "check:standards": "python3 scripts/check-production-standards.py",
    "check:gate": "bash scripts/check-skill-gate.sh",
    "clean": "turbo run clean && rm -rf node_modules && rm -rf apps/*/node_modules && rm -rf packages/*/node_modules && rm -rf services/*/node_modules"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "playwright": "^1.64.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "turbo": "^2.10.9",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "fast-uri": "^4.1.5",
    "@xmldom/xmldom": "^0.9.12",
    "xmldom": "^0.6.0",
    "tar": "^7.5.21",
    "postcss": "^8.5.23",
    "decode-uri-component": "^0.5.0",
    "deepmerge-ts": "^8.0.0",
    "image-size": "^2.0.3",
    "uuid": "^11.1.1",
    "sharp": "^0.35.5",
    "browserslist": "^4.28.7",
    "shell-quote": "^1.12.0",
    "compression": "^1.8.2",
    "source-map-js": "^1.2.2",
    "http-cache-semantics": "^4.3.0",
    "engine.io": "^6.6.10",
    "undici@>=6.0.0 <7": "^6.28.1",
    "brace-expansion@<2": "^1.1.21",
    "brace-expansion@>=2.0.0 <3": "^2.1.7",
    "brace-expansion@>=4.0.0 <6": "^5.0.12",
    "@bukiebrainjobs/mobile>react": "18.3.1",
    "@bukiebrainjobs/mobile>react-dom": "18.3.1"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "^4.1.5",
      "@xmldom/xmldom": "^0.9.12",
      "xmldom": "^0.6.0",
      "tar": "^7.5.21",
      "postcss": "^8.5.23",
      "decode-uri-component": "^0.5.0",
      "deepmerge-ts": "^8.0.0",
      "image-size": "^2.0.3",
      "uuid": "^11.1.1",
      "sharp": "^0.35.5",
      "browserslist": "^4.28.7",
      "shell-quote": "^1.12.0",
      "compression": "^1.8.2",
      "source-map-js": "^1.2.2",
      "http-cache-semantics": "^4.3.0",
      "engine.io": "^6.6.10",
      "undici@>=6.0.0 <7": "^6.28.1",
      "brace-expansion@<2": "^1.1.21",
      "brace-expansion@>=2.0.0 <3": "^2.1.7",
      "brace-expansion@>=4.0.0 <6": "^5.0.12",
      "@bukiebrainjobs/mobile>react": "18.3.1",
      "@bukiebrainjobs/mobile>react-dom": "18.3.1"
    },
    "patchedDependencies": {
      "metro@0.81.5": "patches/metro@0.81.5.patch"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ]
}
